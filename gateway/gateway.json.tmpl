{
  "bitcoind": {
    "rpcurl": "${NODE_RPC_URL}",
    "rpcuser": "${RPC_USER}",
    "rpcpassword": "${RPC_PASS}",
    "work_update_seconds": 40,
    "notify_fallback": true
  },
  "mining": {
    "pool_address": "${MINER_ADDRESS}",
    "coinbase_tag_primary": "Bitcoin Xor",
    "coinbase_tag_secondary": "${COINBASE_TAG_SECONDARY}"
  },
  "stratum": {
    "listen_addr": "0.0.0.0",
    "listen_port": 23334,
    "require_address_username": false,
    "max_threads": 8,
    "max_clients_per_thread": 1024,
    "max_clients": 8192
  },
  "datum": {
    "pool_host": "${POOL_HOST}",
    "pool_port": ${POOL_PORT},
    "pooled_mining_only": false,
    "pool_pubkey": "${POOL_PUBKEY}"
  },
  "api": {
    "listen_addr": "0.0.0.0",
    "listen_port": 8000,
    "miner_listen_addr": "0.0.0.0",
    "miner_listen_port": 8001
  }
}
