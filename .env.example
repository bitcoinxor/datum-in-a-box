# ============================================================
#  DATUM-in-a-box  —  edit ONLY the first line, then run setup
# ============================================================

# >>> YOUR OWN WALLET ADDRESS  (make one with the Shrike wallet — NEVER an exchange address) <<<
MINER_ADDRESS=bc1qCHANGE_ME_TO_YOUR_OWN_ADDRESS

# ---------- leave everything below at the defaults ----------

# Where your gateway sends its self-built blocks for payout coordination:
#   POOL_HOST=datum.xorpool.com   -> pooled DATUM (shared TIDES payouts, on Bitcoin Xor)
#   POOL_HOST=                    -> FULLY SOLO (keep 100% of every block you find, no pool)
POOL_HOST=datum.xorpool.com
POOL_PORT=28915
POOL_PUBKEY=b83aedbba54ba2aa605c76859d97aebd16dece3284402b9fc874778a974da4acbb449f6ccda61625d700036f0487a05f5184f79a07abf2880da77352f4cc487e

# Port your ASICs point at (on this machine's IP).
STRATUM_PORT=23334

# Optional short tag stamped into blocks YOU build (leave blank for none).
COINBASE_TAG_SECONDARY=

# Node prune size in MB (10000 = ~10GB). RPC creds are local-only; setup.sh randomises the password.
PRUNE_MB=10000
RPC_USER=xor
RPC_PASS=CHANGE_ME_any_random_string
